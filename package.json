{
  "name": "es-odm",
  "version": "8.0.0",
  "description": "Object Document Mapper for Elasticsearch 9 - maps ES documents onto JavaScript classes with Joi validation, bulk operations and multi-tenant aliases",
  "type": "module",
  "keywords": [
    "elasticsearch",
    "elastic",
    "odm",
    "orm",
    "object-document-mapper",
    "mapper",
    "model",
    "schema",
    "joi",
    "bulk",
    "multi-tenant",
    "typescript",
    "esm",
    "circularo"
  ],
  "main": "index.js",
  "types": "./types/index.d.ts",
  "files": [
    "index.js",
    "lib",
    "types"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PALAXO/es-odm.git"
  },
  "homepage": "https://github.com/PALAXO/es-odm",
  "license": "MIT",
  "scripts": {
    "test": "mocha --recursive \"test/**/*.test.js\" --exit",
    "lint": "eslint .",
    "coverage": "c8 npm run test",
    "types": "node scripts/types.js && tsc -p test/types/tsconfig.json",
    "prepublishOnly": "node scripts/types.js --check && tsc -p test/types/tsconfig.json"
  },
  "c8": {
    "exclude": [
      "test/**",
      "scripts/**"
    ],
    "reporter": [
      "html",
      "text-summary"
    ]
  },
  "dependencies": {
    "@elastic/elasticsearch": "9.2.1",
    "bunyan": "1.8.15",
    "joi": "18.2.9",
    "lodash": "4.18.1",
    "nconf": "0.13.0",
    "stream-json": "3.7.0",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "c8": "12.0.0",
    "chai": "6.3.0",
    "chai-as-promised": "8.0.2",
    "eslint": "10.12.0",
    "eslint-plugin-jsdoc": "65.3.2",
    "eslint-plugin-mocha": "12.0.2",
    "eslint-plugin-promise": "7.3.0",
    "globals": "17.13.0",
    "mocha": "12.0.3",
    "typescript": "7.0.2"
  },
  "typesVersions": {
    "*": {
      "lib/*": [
        "./types/lib/*"
      ]
    }
  }
}
